{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://hoardcti.dev/roadmap.schema.json",
	"title": "Hoard CTI roadmap config",
	"description": "Which roadmaps exist and which GitHub repo backs each one. Milestones, issues and statuses are fetched from GitHub by scripts/fetch-roadmap.mjs.",
	"type": "object",
	"required": [
		"meta",
		"roadmaps"
	],
	"properties": {
		"$schema": {
			"type": "string"
		},
		"meta": {
			"type": "object",
			"required": [
				"name"
			],
			"properties": {
				"name": {
					"type": "string"
				},
				"tagline": {
					"type": "string"
				},
				"description": {
					"type": "string"
				},
				"github": {
					"type": "string",
					"format": "uri"
				},
				"project": {
					"type": "object",
					"description": "Org-level GitHub Project (v2) whose single-select field supplies issue statuses. Needs ROADMAP_TOKEN with project read access.",
					"required": [
						"org",
						"number"
					],
					"properties": {
						"org": {
							"type": "string"
						},
						"number": {
							"type": "integer",
							"minimum": 1
						},
						"statusField": {
							"type": "string",
							"default": "Status"
						}
					},
					"additionalProperties": false
				}
			},
			"additionalProperties": true
		},
		"roadmaps": {
			"type": "array",
			"minItems": 1,
			"items": {
				"$ref": "#/$defs/roadmap"
			}
		}
	},
	"additionalProperties": false,
	"$defs": {
		"status": {
			"enum": [
				"done",
				"in-progress",
				"planned",
				"blocked"
			],
			"description": "Unknown values fall back to 'planned' at render time."
		},
		"roadmap": {
			"type": "object",
			"required": [
				"id",
				"title"
			],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z0-9-]+$",
					"description": "URL slug. The roadmap with id 'main' (or main: true) is the front page."
				},
				"title": {
					"type": "string"
				},
				"summary": {
					"type": "string"
				},
				"icon": {
					"type": "string",
					"description": "Icon key, see src/lib/components/Icon.svelte for the available set."
				},
				"group": {
					"type": "string",
					"description": "Sidebar section heading, e.g. 'Architecture'."
				},
				"main": {
					"type": "boolean"
				},
				"status": {
					"enum": [
						"done",
						"in-progress",
						"planned",
						"blocked"
					],
					"description": "Optional override; normally derived from the GitHub issues."
				},
				"repo": {
					"type": "object",
					"required": [
						"name",
						"url"
					],
					"properties": {
						"name": {
							"type": "string"
						},
						"url": {
							"type": "string",
							"format": "uri"
						}
					},
					"additionalProperties": false,
					"description": "GitHub repository whose milestones and issues make up this roadmap."
				},
				"intro": {
					"type": "object",
					"properties": {
						"heading": {
							"type": "string"
						},
						"body": {
							"type": "string"
						},
						"callout": {
							"type": "object",
							"required": [
								"body"
							],
							"properties": {
								"type": {
									"enum": [
										"info",
										"warning",
										"success"
									]
								},
								"title": {
									"type": "string"
								},
								"body": {
									"type": "string"
								}
							},
							"additionalProperties": false
						}
					},
					"additionalProperties": false
				}
			},
			"additionalProperties": false
		}
	}
}
