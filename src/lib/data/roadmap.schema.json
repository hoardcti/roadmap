{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://hoardcti.dev/roadmap.schema.json",
	"title": "Hoard CTI roadmap",
	"description": "Single source of truth for the roadmap site. Safe to write from automation.",
	"type": "object",
	"required": ["meta", "roadmaps"],
	"properties": {
		"$schema": { "type": "string" },
		"meta": {
			"type": "object",
			"required": ["name"],
			"properties": {
				"name": { "type": "string" },
				"tagline": { "type": "string" },
				"description": { "type": "string" },
				"github": { "type": "string", "format": "uri" },
				"updatedAt": {
					"type": "string",
					"description": "ISO date (YYYY-MM-DD) of the last update.",
					"pattern": "^\\d{4}-\\d{2}-\\d{2}"
				}
			},
			"additionalProperties": true
		},
		"roadmaps": {
			"type": "array",
			"minItems": 1,
			"items": { "$ref": "#/$defs/roadmap" }
		}
	},
	"additionalProperties": false,
	"$defs": {
		"status": {
			"enum": ["done", "in-progress", "planned", "blocked"],
			"description": "Unknown values fall back to 'planned' at render time."
		},
		"roadmap": {
			"type": "object",
			"required": ["id", "title"],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z0-9-]+$",
					"description": "URL slug. The roadmap with id 'main' (or main: true) is the front page."
				},
				"title": { "type": "string" },
				"summary": { "type": "string" },
				"icon": {
					"type": "string",
					"description": "Icon key, see src/lib/components/Icon.svelte for the available set."
				},
				"group": {
					"type": "string",
					"description": "Sidebar section heading, e.g. 'Architecture'."
				},
				"main": { "type": "boolean" },
				"status": { "$ref": "#/$defs/status" },
				"repo": {
					"type": "object",
					"required": ["name", "url"],
					"properties": {
						"name": { "type": "string" },
						"url": { "type": "string", "format": "uri" }
					},
					"additionalProperties": false
				},
				"intro": {
					"type": "object",
					"properties": {
						"heading": { "type": "string" },
						"body": { "type": "string" },
						"callout": {
							"type": "object",
							"required": ["body"],
							"properties": {
								"type": { "enum": ["info", "warning", "success"] },
								"title": { "type": "string" },
								"body": { "type": "string" }
							},
							"additionalProperties": false
						}
					},
					"additionalProperties": false
				},
				"milestones": {
					"type": "array",
					"items": { "$ref": "#/$defs/milestone" }
				}
			},
			"additionalProperties": false
		},
		"milestone": {
			"type": "object",
			"required": ["id", "title"],
			"properties": {
				"id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
				"title": { "type": "string" },
				"description": { "type": "string" },
				"status": { "$ref": "#/$defs/status" },
				"target": { "type": "string", "description": "Free text, e.g. 'Q3 2026'." },
				"items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
			},
			"additionalProperties": false
		},
		"item": {
			"type": "object",
			"required": ["id", "title"],
			"properties": {
				"id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
				"title": { "type": "string" },
				"description": { "type": "string" },
				"status": { "$ref": "#/$defs/status" },
				"tags": { "type": "array", "items": { "type": "string" } },
				"note": { "type": "string" },
				"link": {
					"type": "object",
					"required": ["label"],
					"properties": {
						"label": { "type": "string" },
						"url": { "type": "string", "format": "uri" },
						"roadmap": { "type": "string", "description": "Id of another roadmap." }
					},
					"additionalProperties": false
				}
			},
			"additionalProperties": false
		}
	}
}
